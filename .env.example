# Supabase (público — cliente navegador / lectura escuelas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (privado — solo servidor; nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Email transaccional (privado — solo servidor; nunca NEXT_PUBLIC_)
RESEND_API_KEY=
# Secreto de firma Svix del webhook de Resend; solo servidor.
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# Opcional; por defecto seguro: info@flypath.es
EMAIL_REPLY_TO=
# Destinatario de los avisos internos de solicitudes de acompañamiento.
INTERNAL_ALERT_EMAIL=

# Stripe sandbox/test - solo servidor. Checkout y webhooks se configuran por bloques.
STRIPE_SECRET_KEY=
# Secreto de firma del webhook Stripe sandbox (`whsec_`); solo servidor.
STRIPE_WEBHOOK_SECRET=
# URL publica canonica para success/cancel de Checkout. En local: http://localhost:3000.
NEXT_PUBLIC_APP_URL=
