# Supabase (público — cliente navegador / lectura escuelas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (privado — solo servidor; nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Email transaccional (privado — solo servidor; nunca NEXT_PUBLIC_)
RESEND_API_KEY=
# Secreto de firma Svix del webhook de Resend; solo servidor.
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# Opcional; por defecto seguro: info@flypath.es
EMAIL_REPLY_TO=
# Destinatario de los avisos internos de solicitudes de acompañamiento.
INTERNAL_ALERT_EMAIL=

# Stripe sandbox/test - solo servidor. Checkout y webhooks se configuran por bloques.
STRIPE_SECRET_KEY=
# Secreto de firma del webhook Stripe sandbox (`whsec_`); solo servidor.
STRIPE_WEBHOOK_SECRET=
# URL publica canonica para success/cancel de Checkout. En local: http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Override interno opcional de AeroComms. Solo funciona en development/test.
NEXT_PUBLIC_AEROCOMMS_DEV_UNLOCK_ALL=false

# AeroComms voice abuse protection — server-only random value (32+ characters).
# Used only to HMAC rate-limit subjects before they are stored in Supabase.
AEROCOMMS_VOICE_RATE_LIMIT_SALT=

# Protección antiabuso para formularios públicos. Valor aleatorio server-only (32+ caracteres).
# Se usa exclusivamente para HMAC de IPs/emails antes de guardarlos en Supabase.
PUBLIC_FORM_RATE_LIMIT_SALT=

# Cal.com — solo servidor. El webhook firma el cuerpo crudo con HMAC SHA-256.
# La API queda reservada para conciliación futura; no se usa en esta primera proyección.
CALCOM_WEBHOOK_SECRET=
CALCOM_API_KEY=
CALCOM_API_VERSION=
CALCOM_MENTORSHIP_EVENT_TYPE_ID=
