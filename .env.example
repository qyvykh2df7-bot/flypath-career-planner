# Supabase (público — cliente navegador / lectura escuelas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (privado — solo servidor; nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Email transaccional (privado — solo servidor; nunca NEXT_PUBLIC_)
RESEND_API_KEY=
# Secreto de firma Svix del webhook de Resend; solo servidor.
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# Opcional; por defecto seguro: info@flypath.es
EMAIL_REPLY_TO=
# Destinatario de los avisos internos de solicitudes de acompañamiento.
INTERNAL_ALERT_EMAIL=

# Stripe sandbox/test - solo servidor. Checkout y webhooks se configuran por bloques.
STRIPE_SECRET_KEY=
# Secreto de firma del webhook Stripe sandbox (`whsec_`); solo servidor.
STRIPE_WEBHOOK_SECRET=
# Canonical public FlyPath origin. Required outside local development; Preview
# uses this same approved origin to avoid reflecting an untrusted Host header.
FLYPATH_CANONICAL_ORIGIN=

# Override interno opcional de AeroComms. Solo funciona en development/test.
NEXT_PUBLIC_AEROCOMMS_DEV_UNLOCK_ALL=false

# AeroComms voice abuse protection — server-only random value (32+ characters).
# Used only to HMAC rate-limit subjects before they are stored in Supabase.
AEROCOMMS_VOICE_RATE_LIMIT_SALT=

# Protección antiabuso para formularios públicos. Valor aleatorio server-only (32+ caracteres).
# Se usa exclusivamente para HMAC de IPs/emails antes de guardarlos en Supabase.
PUBLIC_FORM_RATE_LIMIT_SALT=

# OpenAI — solo servidor. Las APIs de voz y el planificador privado de Content OS
# usan esta clave sin exponerla al navegador.
OPENAI_API_KEY=
# Modelo opcional para el planificador; por defecto: gpt-5.6-terra.
CONTENT_OS_PLANNER_MODEL=
# Intervalo mínimo configurable entre propuestas IA de Content OS (segundos).
# Por defecto: 60; valores admitidos: 15 a 3600.
CONTENT_OS_PLANNER_MIN_INTERVAL_SECONDS=
# Modelo opcional para el Content Strategist; por defecto: gpt-5.6-terra.
CONTENT_OS_STRATEGIST_MODEL=
# Intervalo mínimo entre generaciones estratégicas (segundos).
# Por defecto: 60; valores admitidos: 15 a 3600.
CONTENT_OS_STRATEGIST_MIN_INTERVAL_SECONDS=
# TikTok Content Intelligence — OAuth y tokens solo servidor.
# Redirect registrado: https://<dominio>/api/warhome/content/integrations/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Clave AES-256 aleatoria, codificada en base64 (32 bytes).
CONTENT_OS_TIKTOK_TOKEN_ENCRYPTION_KEY=
# Máximo de vídeos públicos por sincronización (1-100; por defecto 20).
CONTENT_OS_TIKTOK_SYNC_MAX_VIDEOS=
# Modelo opcional para clasificar importaciones; por defecto: gpt-5.6-terra.
CONTENT_OS_TIKTOK_ANALYSIS_MODEL=

# Cal.com — solo servidor. El webhook firma el cuerpo crudo con HMAC SHA-256.
# La API queda reservada para conciliación futura; no se usa en esta primera proyección.
CALCOM_WEBHOOK_SECRET=
CALCOM_API_KEY=
CALCOM_API_VERSION=
CALCOM_MENTORSHIP_EVENT_TYPE_ID=
